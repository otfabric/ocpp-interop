{
  "schemaVersion": "1.0",
  "name": "baseline",
  "ocppVersion": "2.0.1",
  "description": "Two-EVSE AC station and a CSMS that accepts it. Covers provisioning, authorization, TransactionEvent, the device model and smart charging answers.",
  "stations": [
    {
      "id": "OT-FABRIC-TEST-001",
      "vendor": "OTFabric",
      "model": "TestStation",
      "serialNumber": "OTF-0001",
      "firmwareVersion": "1.0.0",
      "password": "OTFabricTestPass0001",
      "evses": [
        {"id": 1, "connectors": [1]},
        {"id": 2, "connectors": [1]}
      ]
    }
  ],
  "idTokens": [
    {"idToken": "04A1B2C3D4E5F6", "type": "ISO14443", "status": "Accepted"},
    {"idToken": "04BLOCKED00001", "type": "ISO14443", "status": "Blocked"},
    {"idToken": "04EXPIRED00001", "type": "ISO14443", "status": "Expired"}
  ],
  "variables": [
    {"component": {"name": "OCPPCommCtrlr"}, "variable": {"name": "HeartbeatInterval"}, "value": "300", "mutability": "ReadWrite"},
    {"component": {"name": "SampledDataCtrlr"}, "variable": {"name": "TxUpdatedInterval"}, "value": "60", "mutability": "ReadWrite"},
    {"component": {"name": "AuthCtrlr"}, "variable": {"name": "AuthorizeRemoteStart"}, "value": "true", "mutability": "ReadWrite"},
    {"component": {"name": "ChargingStation"}, "variable": {"name": "AvailabilityState"}, "value": "Available", "mutability": "ReadOnly"}
  ],
  "answers": {
    "csms": {
      "BootNotification": {"payload": {"status": "Accepted", "currentTime": "${now}", "interval": 300}},
      "Heartbeat": {"payload": {"currentTime": "${now}"}},
      "Authorize": {"derived": "idTokens"},
      "TransactionEvent": {"payload": {}},
      "StatusNotification": {"payload": {}},
      "MeterValues": {"payload": {}},
      "NotifyReport": {"payload": {}},
      "NotifyEvent": {"payload": {}},
      "SecurityEventNotification": {"payload": {}},
      "FirmwareStatusNotification": {"payload": {}},
      "LogStatusNotification": {"payload": {}},
      "DataTransfer": {"payload": {"status": "UnknownVendorId"}}
    },
    "station": {
      "RequestStartTransaction": {"payload": {"status": "Accepted"}},
      "RequestStopTransaction": {"payload": {"status": "Accepted"}},
      "GetVariables": {"derived": "variables"},
      "SetVariables": {"derived": "variables"},
      "GetBaseReport": {"payload": {"status": "Accepted"}},
      "ChangeAvailability": {"payload": {"status": "Accepted"}},
      "ClearCache": {"payload": {"status": "Accepted"}},
      "Reset": {"payload": {"status": "Accepted"}},
      "UnlockConnector": {"payload": {"status": "Unlocked"}},
      "TriggerMessage": {"payload": {"status": "Accepted"}},
      "SetChargingProfile": {"payload": {"status": "Accepted"}},
      "ClearChargingProfile": {"payload": {"status": "Accepted"}},
      "GetLocalListVersion": {"payload": {"versionNumber": 0}},
      "DataTransfer": {"payload": {"status": "UnknownVendorId"}}
    }
  },
  "samples": {
    "boot": {"action": "BootNotification", "from": "station", "payload": {
      "reason": "PowerUp",
      "chargingStation": {"vendorName": "OTFabric", "model": "TestStation",
        "serialNumber": "OTF-0001", "firmwareVersion": "1.0.0"}}},
    "heartbeat": {"action": "Heartbeat", "from": "station", "payload": {}},
    "statusAvailable": {"action": "StatusNotification", "from": "station", "payload": {
      "timestamp": "2026-01-01T10:00:00Z", "connectorStatus": "Available", "evseId": 1, "connectorId": 1}},
    "authorizeAccepted": {"action": "Authorize", "from": "station", "payload": {
      "idToken": {"idToken": "04A1B2C3D4E5F6", "type": "ISO14443"}}},
    "authorizeBlocked": {"action": "Authorize", "from": "station", "payload": {
      "idToken": {"idToken": "04BLOCKED00001", "type": "ISO14443"}}},
    "transactionStarted": {"action": "TransactionEvent", "from": "station", "payload": {
      "eventType": "Started", "timestamp": "2026-01-01T10:00:00Z", "triggerReason": "Authorized", "seqNo": 0,
      "transactionInfo": {"transactionId": "OTF-TX-0001"},
      "evse": {"id": 1, "connectorId": 1},
      "idToken": {"idToken": "04A1B2C3D4E5F6", "type": "ISO14443"}}},
    "transactionUpdated": {"action": "TransactionEvent", "from": "station", "payload": {
      "eventType": "Updated", "timestamp": "2026-01-01T10:05:00Z", "triggerReason": "MeterValuePeriodic", "seqNo": 1,
      "transactionInfo": {"transactionId": "OTF-TX-0001", "chargingState": "Charging"},
      "meterValue": [{"timestamp": "2026-01-01T10:05:00Z", "sampledValue": [
        {"value": 1234.0, "measurand": "Energy.Active.Import.Register"}]}]}},
    "transactionEnded": {"action": "TransactionEvent", "from": "station", "payload": {
      "eventType": "Ended", "timestamp": "2026-01-01T10:30:00Z", "triggerReason": "StopAuthorized", "seqNo": 2,
      "transactionInfo": {"transactionId": "OTF-TX-0001", "stoppedReason": "Local"}}},
    "meterValues": {"action": "MeterValues", "from": "station", "payload": {
      "evseId": 1,
      "meterValue": [{"timestamp": "2026-01-01T10:05:00Z", "sampledValue": [
        {"value": 7360.0, "measurand": "Power.Active.Import"}]}]}},
    "requestStart": {"action": "RequestStartTransaction", "from": "csms", "payload": {
      "evseId": 1, "remoteStartId": 1, "idToken": {"idToken": "04A1B2C3D4E5F6", "type": "ISO14443"}}},
    "requestStop": {"action": "RequestStopTransaction", "from": "csms", "payload": {"transactionId": "OTF-TX-0001"}},
    "getVariables": {"action": "GetVariables", "from": "csms", "payload": {
      "getVariableData": [{"component": {"name": "OCPPCommCtrlr"}, "variable": {"name": "HeartbeatInterval"}}]}},
    "setVariables": {"action": "SetVariables", "from": "csms", "payload": {
      "setVariableData": [{"component": {"name": "OCPPCommCtrlr"}, "variable": {"name": "HeartbeatInterval"}, "attributeValue": "120"}]}},
    "resetImmediate": {"action": "Reset", "from": "csms", "payload": {"type": "Immediate"}},
    "triggerHeartbeat": {"action": "TriggerMessage", "from": "csms", "payload": {"requestedMessage": "Heartbeat"}},
    "setTxDefaultProfile": {"action": "SetChargingProfile", "from": "csms", "payload": {
      "evseId": 0,
      "chargingProfile": {
        "id": 1, "stackLevel": 0,
        "chargingProfilePurpose": "TxDefaultProfile", "chargingProfileKind": "Absolute",
        "chargingSchedule": [{"id": 1, "chargingRateUnit": "W", "startSchedule": "2026-01-01T00:00:00Z",
          "chargingSchedulePeriod": [{"startPeriod": 0, "limit": 11000.0}]}]}}}
  }
}
